{
  "$schema": "https://opencode.ai",
  "watcher": {
    "ignore": [
      ".git/**",
      "vendor/**",
      "projects/**",
      "register_data/**",
      "bin/**",
      "dist/**",
      "tmp/**",
      "*.exe",
      "*.dll",
      "*.so",
      "*.dylib",
      "*.test",
      "*.out",
      "*.prof",
      "*.log"
    ]
  },
  "permissions": {
    "read": {
      ".env*": "deny",
      "!.env.example": "allow",
      "vendor/**": "deny",
      "projects/**": "deny",
      "register_data/**": "deny",
      "bin/**": "deny",
      "dist/**": "deny",
      "tmp/**": "deny",
      "go.sum": "deny",
      "*.exe": "deny",
      "*.test": "deny",
      "*.out": "deny",
      "*.prof": "deny",
      "runner.log/**": "deny"
    },
    "glob": {
      "vendor/**": "deny",
      "bin/**": "deny",
      "dist/**": "deny",
      "projects/**": "deny",
      "register_data/**": "deny",
      "runner.log/**": "deny"
    },
    "grep": {
      "vendor/**": "deny",
      "bin/**": "deny",
      "dist/**": "deny",
      "projects/**": "deny",
      "register_data/**": "deny",
      "runner.log/**": "deny"
    }
  }
}
